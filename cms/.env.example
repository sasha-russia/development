# Database (local: docker compose up db)
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/newsroom
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the editorial system, e.g. https://cms.example.ru
SERVER_URL=http://localhost:3000
# Public site address; used for article links in social posts and CORS
SITE_URL=https://sasha-russia.github.io/development

# Site rebuild on publish: fine-grained token with "Contents: read and write" on the repo
GITHUB_TOKEN=
GITHUB_REPO=sasha-russia/development

# Telegram: bot from @BotFather, added to the channel as an admin
TELEGRAM_BOT_TOKEN=
# @channel_username or numeric id like -1001234567890
TELEGRAM_CHAT_ID=

# VK: user token of a community admin with the "wall" scope; group id without the minus
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# MAX: bot token from the MAX partner platform; channel id
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# MAX uses the Russian Trusted Root CA: path to its PEM file
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/russian_trusted_root_ca.pem

# First administrator for `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
