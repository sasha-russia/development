# Адрес системы и домен для HTTPS
BASE_URL=https://social.a-platonov.ru
DOMAIN=social.a-platonov.ru

# Вход: первый администратор создаётся при первом запуске
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Случайная строка: openssl rand -hex 32
SECRET_KEY=

# Telegram: приложение на https://my.telegram.org → API development tools.
# Вход в сам аккаунт — в интерфейсе: Настройки → Telegram.
TG_API_ID=
TG_API_HASH=

# ВКонтакте: сервисный ключ приложения (vk.com/apps?act=manage → приложение → Настройки)
VK_TOKEN=

# Классификация сообщений. Без ключа — разметка по словарям.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# MAX: токен бота и ID чата или канала, куда слать отчёты (или MAX_USER_ID для личных сообщений)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_USER_ID=

# Сбор: как часто проверять источники (минуты) и за сколько дней брать историю при первом запуске
POLL_MINUTES=10
PRIORITY_POLL_MINUTES=5
BACKFILL_DAYS=3

# Контакт для Nominatim (геокодер OpenStreetMap), по правилам сервиса
NOMINATIM_EMAIL=
